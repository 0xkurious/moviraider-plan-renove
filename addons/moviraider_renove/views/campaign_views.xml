<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="renove_campaign_view_form" model="ir.ui.view">
        <field name="name">renove.campaign.form</field>
        <field name="model">renove.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_segment" string="Calcular segmento" type="object" class="btn-primary"/>
                    <button name="action_prepare_mailing" string="Preparar correo" type="object"
                            invisible="eligible_count == 0"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="converted_count" widget="statinfo" string="Compraron"/>
                        </button>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group string="Regla del segmento">
                            <field name="cutoff_date"/>
                            <field name="deadline"/>
                            <field name="days_left"/>
                        </group>
                        <group string="Embudo">
                            <field name="eligible_count" string="Contactables"/>
                            <field name="no_consent_count" string="Sin consentimiento"/>
                            <field name="no_contact_count" string="Sin vía de contacto"/>
                            <field name="renewed_count" string="Ya renovados"/>
                            <field name="request_count"/>
                            <field name="converted_count" string="Han comprado"/>
                            <field name="revenue"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Oferta">
                        <field name="discount_code"/>
                        <field name="offer_text"/>
                        <field name="utm_campaign_id"/>
                        <field name="mailing_id"/>
                    </group>
                    <notebook>
                        <page string="Clientes del segmento">
                            <field name="line_ids">
                                <list decoration-success="converted" decoration-muted="status != 'eligible'">
                                    <field name="partner_id"/>
                                    <field name="email"/>
                                    <field name="legacy_product_ids" widget="many2many_tags"/>
                                    <field name="last_legacy_date"/>
                                    <field name="status" widget="badge"/>
                                    <field name="converted" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="renove_campaign_view_list" model="ir.ui.view">
        <field name="name">renove.campaign.list</field>
        <field name="model">renove.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="days_left"/>
                <field name="eligible_count"/>
                <field name="converted_count"/>
                <field name="revenue"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="renove_campaign_action" model="ir.actions.act_window">
        <field name="name">Campañas Renove</field>
        <field name="res_model">renove.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_renove_root" name="Renove" parent="sale.sale_menu_root" sequence="40"/>
    <menuitem id="menu_renove_campaign" name="Campañas" parent="menu_renove_root"
              action="renove_campaign_action" sequence="10"/>
    <menuitem id="menu_renove_request" name="Solicitudes de visita" parent="menu_renove_root"
              action="renove_request_action" sequence="20"/>
</odoo>
