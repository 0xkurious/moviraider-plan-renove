<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dgt_case_view_list" model="ir.ui.view">
        <field name="name">dgt.case.list</field>
        <field name="model">dgt.case</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_stalled" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="scooter_id"/>
                <field name="days_open"/>
                <field name="is_stalled" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="dgt_case_view_form" model="ir.ui.view">
        <field name="name">dgt.case.form</field>
        <field name="model">dgt.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_data" string="Registrar datos recibidos" type="object"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_validate" string="Validar" type="object"
                            class="btn-primary" invisible="state != 'received'"/>
                    <button name="action_send_gestoria" string="Enviar a gestoría" type="object"
                            class="btn-primary" invisible="state != 'validated'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('sent', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,received,validated,sent"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group string="Pedido">
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="scooter_id"/>
                            <field name="days_open"/>
                        </group>
                        <group string="Datos del titular">
                            <field name="owner_vat" readonly="state != 'pending'"/>
                            <field name="serial_number" readonly="state != 'pending'"/>
                            <field name="consent_gestoria" readonly="state != 'pending'"/>
                            <field name="data_received_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dgt_case_action" model="ir.actions.act_window">
        <field name="name">Expedientes DGT</field>
        <field name="res_model">dgt.case</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dgt_case" name="Expedientes DGT"
              parent="sale.sale_order_menu" action="dgt_case_action" sequence="30"/>
</odoo>
