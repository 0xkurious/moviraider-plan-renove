<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_catalog" model="ir.ui.view">
        <field name="name">product.template.form.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="is_scooter"/>
                <field name="has_dgt_certificate" invisible="not is_scooter"/>
                <field name="weight_kg" invisible="not is_scooter"/>
                <field name="max_speed_kmh" invisible="not is_scooter"/>
            </xpath>
        </field>
    </record>
</odoo>
