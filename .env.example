# Copia este archivo a .env (git lo ignora) y rellénalo. NUNCA subas .env al repositorio.
# Sin .env el adaptador funciona en modo simulado y no envía nada a nadie.

# mock = simula y guarda el mensaje (por defecto) | respondio = envía de verdad por WhatsApp
PROVIDER=mock

# --- Solo para PROVIDER=respondio ---------------------------------------------------------
# Token: respond.io > Settings > Integrations > Developer API > Add Access Token
RESPONDIO_TOKEN=
# Opcional en modo texto (usa el último canal con el que habló el contacto). Obligatorio en modo plantilla.
RESPONDIO_CHANNEL_ID=
# OBLIGATORIO en modo real: únicos números a los que se permite escribir, separados por comas.
# Los datos de demo llevan teléfonos inventados que podrían ser de personas reales.
LIVE_ALLOWED_PHONES=
# text = mensaje libre (solo dentro de las 24 h siguientes a que TÚ escribas al número de empresa)
# template = plantilla aprobada (puede escribir primero la empresa)
MESSAGE_MODE=text
